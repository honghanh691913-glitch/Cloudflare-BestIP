{
  "version": 1,
  "listen": ":8080",
  "max_concurrency": 2,
  "providers": [
    {
      "id": "cf-main",
      "name": "Cloudflare 主账号",
      "type": "cloudflare",
      "zone_domain": "629717.xyz",
      "zone_id": "YOUR_ZONE_ID",
      "auth_mode": "api_token",
      "api_token": "YOUR_API_TOKEN",
      "email": "",
      "api_key": ""
    }
  ],
  "sources": [
    {
      "id": "cf-v4",
      "name": "Cloudflare IPv4",
      "enabled": false,
      "family": "ipv4",
      "inputs": [
        "https://example.com/ipv4-list.txt"
      ],
      "interval_minutes": 360,
      "keep_results": 50,
      "cfst": {
        "binary": "cfst",
        "url": "https://speed.cloudflare.com/__down?bytes=200000000",
        "port": 443,
        "threads": 4,
        "ping_count": 200,
        "download_count": 10,
        "download_time": 10,
        "latency_max_ms": 100,
        "latency_min_ms": 0,
        "loss_max": 0.1,
        "speed_min_mb": 40,
        "httping": true,
        "colo": [],
        "all_ip": false
      }
    },
    {
      "id": "cf-v6",
      "name": "Cloudflare IPv6",
      "enabled": false,
      "family": "ipv6",
      "inputs": [
        "https://example.com/ipv6-list.txt"
      ],
      "interval_minutes": 360,
      "keep_results": 50,
      "cfst": {
        "binary": "cfst",
        "url": "https://speed.cloudflare.com/__down?bytes=200000000",
        "port": 443,
        "threads": 4,
        "ping_count": 200,
        "download_count": 10,
        "download_time": 10,
        "latency_max_ms": 100,
        "latency_min_ms": 0,
        "loss_max": 0.1,
        "speed_min_mb": 40,
        "httping": true,
        "colo": [],
        "all_ip": false
      }
    },
    {
      "id": "nrt-v4",
      "name": "NRT IPv4",
      "enabled": false,
      "family": "ipv4",
      "inputs": [
        "https://example.com/nrt-v4.txt"
      ],
      "interval_minutes": 360,
      "keep_results": 50,
      "cfst": {
        "binary": "cfst",
        "url": "https://speed.cloudflare.com/__down?bytes=200000000",
        "port": 443,
        "threads": 4,
        "ping_count": 200,
        "download_count": 10,
        "download_time": 10,
        "latency_max_ms": 100,
        "latency_min_ms": 0,
        "loss_max": 0.1,
        "speed_min_mb": 40,
        "httping": true,
        "colo": [
          "NRT"
        ],
        "all_ip": false
      }
    },
    {
      "id": "nrt-v6",
      "name": "NRT IPv6",
      "enabled": false,
      "family": "ipv6",
      "inputs": [
        "https://example.com/nrt-v6.txt"
      ],
      "interval_minutes": 360,
      "keep_results": 50,
      "cfst": {
        "binary": "cfst",
        "url": "https://speed.cloudflare.com/__down?bytes=200000000",
        "port": 443,
        "threads": 4,
        "ping_count": 200,
        "download_count": 10,
        "download_time": 10,
        "latency_max_ms": 100,
        "latency_min_ms": 0,
        "loss_max": 0.1,
        "speed_min_mb": 40,
        "httping": true,
        "colo": [
          "NRT"
        ],
        "all_ip": false
      }
    }
  ],
  "targets": [
    {
      "id": "mixed-example",
      "name": "示例备注",
      "enabled": false,
      "provider_id": "cf-main",
      "hostname": "v4.629717.xyz",
      "ttl": 60,
      "proxied": false,
      "sources": [
        {
          "source_id": "cf-v4",
          "count": 5
        },
        {
          "source_id": "cf-v6",
          "count": 5
        }
      ],
      "prefix": "v4"
    },
    {
      "id": "nrtv4-example",
      "name": "NRT IPv4",
      "enabled": false,
      "provider_id": "cf-main",
      "hostname": "nrtv4.629717.xyz",
      "ttl": 60,
      "proxied": false,
      "sources": [
        {
          "source_id": "nrt-v4",
          "count": 5
        }
      ],
      "prefix": "nrtv4"
    }
  ]
}
